if(NOT EXISTS "${SCINTILLA_DLL}")
  message(FATAL_ERROR
    "Pinned Scintilla ${_scintilla_version} DLL is missing: ${SCINTILLA_DLL}. "
    "Run project setup to extract the verified official SciTE archive.")
endif()
if(NOT EXISTS "${SCINTILLA_LICENSE_FILE}")
  message(FATAL_ERROR "The official Scintilla/SciTE License.txt is missing: ${SCINTILLA_LICENSE_FILE}")
endif()

file(READ "${SCINTILLA_DLL}" _mz LIMIT 2 HEX)
if(NOT _mz STREQUAL "4d5a")
  message(FATAL_ERROR "SciLexer.dll is not a valid PE image: ${SCINTILLA_DLL}")
endif()
file(READ "${SCINTILLA_DLL}" _pe_offset_hex OFFSET 60 LIMIT 4 HEX)
string(REGEX MATCHALL ".." _offset_bytes "${_pe_offset_hex}")
list(LENGTH _offset_bytes _offset_byte_count)
if(NOT _offset_byte_count EQUAL 4)
  message(FATAL_ERROR "SciLexer.dll has a truncated DOS header")
endif()
list(GET _offset_bytes 0 _b0)
list(GET _offset_bytes 1 _b1)
list(GET _offset_bytes 2 _b2)
list(GET _offset_bytes 3 _b3)
set(_offset_little_endian "${_b3}${_b2}${_b1}${_b0}")
math(EXPR _pe_offset "0x${_offset_little_endian}")
math(EXPR _machine_offset "${_pe_offset} + 4")
file(READ "${SCINTILLA_DLL}" _pe_signature OFFSET "${_pe_offset}" LIMIT 4 HEX)
file(READ "${SCINTILLA_DLL}" _machine_hex OFFSET "${_machine_offset}" LIMIT 2 HEX)
if(NOT _pe_signature STREQUAL "50450000")
  message(FATAL_ERROR "SciLexer.dll has an invalid PE signature")
endif()
if(NOT _machine_hex STREQUAL "6486")
  message(FATAL_ERROR "SciLexer.dll must be x64 (PE machine 0x8664); got 0x${_machine_hex}")
endif()
message(STATUS "Verified Scintilla ${_scintilla_version} x64 DLL: ${SCINTILLA_DLL}")
