{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Windows x64 (MSVC, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
  "name": "vs2026",
  "displayName": "Visual Studio 2026 x64",
  "generator": "Visual Studio 18 2026",
  "binaryDir": "${sourceDir}/build-vs2026",
  "architecture": "x64",
  "cacheVariables": {
    "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
  }
}
  ],
  "buildPresets": [{ "name": "default", "configurePreset": "default", "configuration": "Debug" }],
  "testPresets": [{ "name": "default", "configurePreset": "default", "configuration": "Debug", "output": { "outputOnFailure": true } }]
}
