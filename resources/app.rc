#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDD_MAIN DIALOGEX 0, 0, 530, 310
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "C言語エラー解説ツール"
FONT 9, "Yu Gothic UI"
BEGIN
    PUSHBUTTON "ファイルを開く", IDC_OPEN_SOURCE, 176, 12, 74, 18, WS_DISABLED
    PUSHBUTTON "テーマ変更", IDC_THEME, 444, 12, 74, 18, WS_DISABLED
    LTEXT "ソースコード入力", -1, 12, 39, 125, 12
    LTEXT "実行結果・エラー", -1, 264, 39, 125, 12
    PUSHBUTTON "結果をコピー", IDC_COPY_RESULT, 444, 35, 74, 16, WS_DISABLED
    EDITTEXT IDC_SOURCE, 12, 54, 238, 194, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    EDITTEXT IDC_RESULT, 264, 54, 254, 194, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON "実行", IDC_RUN, 444, 255, 74, 19, WS_DISABLED
    PUSHBUTTON "保存", IDC_SAVE, 12, 282, 74, 18, WS_DISABLED
    PUSHBUTTON "Gitリポジトリ", IDC_REPOSITORY, 94, 282, 82, 18, WS_DISABLED
END
